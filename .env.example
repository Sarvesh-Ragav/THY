# Copy to .env.local (or set in your host's env UI). Never commit real secrets.

# Backend API (must match your deployed Express host)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4000/api/v1
# Optional: Socket.IO origin if different from the API host
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Google Sign-In (public client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vertex AI / GenAI (optional studio features)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Prefer Workload Identity / host secrets in production instead of a key file
# GOOGLE_APPLICATION_CREDENTIALS=
