# Copy to server/.env (or set in your host's env UI). Never commit real secrets.

PORT=4000
NODE_ENV=production

# Exact frontend origin for CORS (comma-separate extras if needed)
FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/thy_db

# Optional Postgres (payments / legacy profile paths)
# DATABASE_URL=postgres://user:pass@host:5432/thy

# JWT — use long random secrets in production (32+ chars)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEFAULT_PHONE_COUNTRY_CODE=+91
# Must be false in production
EXPOSE_MOCK_OTP=false

# Razorpay (use live keys only in production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Google OAuth (server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
